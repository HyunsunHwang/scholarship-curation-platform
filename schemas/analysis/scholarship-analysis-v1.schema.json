{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scholarship-analysis-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineage",
    "notice_classification",
    "program",
    "cycle",
    "organizations",
    "benefits",
    "application",
    "eligibility_conditions",
    "required_documents",
    "important_cautions",
    "unresolved_fields",
    "evidence"
  ],
  "properties": {
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_id", "revision_id"],
      "properties": {
        "notice_id": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 }
      }
    },
    "notice_classification": {
      "type": "string",
      "enum": ["new_recruitment", "correction", "extension", "result", "general_guidance", "other", "unknown"]
    },
    "program": { "$ref": "#/$defs/namedCandidate" },
    "cycle": { "$ref": "#/$defs/namedCandidate" },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "confidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["operator", "funder", "host", "other", "unknown"] },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "amount_text", "confidence"],
        "properties": {
          "type": { "type": "string", "enum": ["tuition", "cash", "living_expense", "activity", "in_kind", "other", "unknown"] },
          "amount_text": { "type": ["string", "null"] },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "method", "url_or_path"],
      "properties": {
        "start_date": { "$ref": "#/$defs/dateValue" },
        "end_date": { "$ref": "#/$defs/dateValue" },
        "method": { "type": ["string", "null"] },
        "url_or_path": { "type": ["string", "null"] }
      }
    },
    "eligibility_conditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universities", "majors", "grades", "enrollment_statuses"],
      "properties": {
        "universities": { "$ref": "#/$defs/stringArray" },
        "majors": { "$ref": "#/$defs/stringArray" },
        "grades": { "$ref": "#/$defs/stringArray" },
        "enrollment_statuses": { "$ref": "#/$defs/stringArray" }
      }
    },
    "required_documents": { "$ref": "#/$defs/stringArray" },
    "important_cautions": { "$ref": "#/$defs/stringArray" },
    "unresolved_fields": { "$ref": "#/$defs/stringArray" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field_path", "source_kind", "source_id", "locator", "quote", "confidence"],
        "properties": {
          "field_path": { "type": "string", "minLength": 1 },
          "source_kind": { "type": "string", "enum": ["body_text", "attachment_text"] },
          "source_id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "quote": { "type": "string", "minLength": 1, "maxLength": 500 },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "namedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "confidence"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "dateValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "status"],
      "properties": {
        "value": { "type": ["string", "null"], "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$" },
        "status": { "type": "string", "enum": ["confirmed", "approximate", "unknown"] }
      }
    }
  }
}
